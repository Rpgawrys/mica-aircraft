# Retriever bound to "Aircraft KG Strong" (verified DEPLOYED, healthy)
AUTOGRAPH_RETRIEVER_URL=https://<your-deployment>:8529/graphrag/retriever/<pod>
AUTOGRAPH_RETRIEVER_ID=arangodb-graphrag-retriever-<pod>
AUTOGRAPH_DB="Aircraft KG Strong"
STRUCTURED_DB_NAME=aircraft_model
# weak-corpus retriever, for the weak-vs-strong comparison (fill in when deployed)
# AUTOGRAPH_RETRIEVER_URL_WEAK=

# gpt-5.4 rather than 5.5 for agents 3 and 4: 5.5 is the only model here that
# spends reasoning tokens, and it charges them against max_tokens, which is what
# produced intermittent "length limit was reached" failures. 5.4 uses zero
# reasoning tokens, runs 6x faster on a hard question, and diagnoses an empty
# structured result correctly where 5.4-mini blames missing data and proposes a
# duplicate.
# Model provider. The Anthropic key was revoked, so every agent runs on OpenAI.
# Switching back is these four lines plus a working ANTHROPIC_API_KEY.
LLM_PROVIDER=openai
AQL_AGENT_MODEL=gpt-5.4-mini
RECONCILER_MODEL=gpt-5.4
UPDATE_AGENT_MODEL=gpt-5.4

# NL -> AQL engine. "builtin" is agent 1's own prompt (~2s). "aqlizer" is
# ArangoDB's Natural Language to AQL service, ACP name arangodb-graph-rag (~10s,
# introspects the graph itself). The UI can override per question.
AQL_BACKEND=builtin
AQLIZER_POD=<pod>

# Deployment switch (gear icon). Profiles are defined in profiles.py; credentials
# come from ARANGO_PROD_* / ARANGO_SUCCESS_* in ~/.zshenv. The success corpus has
# no retriever or AQLizer yet - when they exist, wire them here and restart:
# last segment of arangodb-graphrag-retriever-xxxxx (deployed 2026-09-08)
AUTOGRAPH_RETRIEVER_POD_SUCCESS=<pod>
# AQLIZER_POD_SUCCESS=xxxxx                  last segment of arangodb-graph-rag-xxxxx
